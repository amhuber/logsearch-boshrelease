# abort script on any command that exit with a non zero value
set -e

# Detect # of CPUs so make jobs can be parallelized
CPUS=`grep -c ^processor /proc/cpuinfo`

HAPROXY_VERSION=2.6.9

echo "Extracting pcre..."
tar xzf haproxy/pcre2-10.42.tar.gz
pushd pcre2-10.42
  ./configure
  make -j${CPUS}
  make install
popd

tar xzf haproxy/haproxy-${HAPROXY_VERSION}.tar.gz
pushd haproxy-${HAPROXY_VERSION}
  make TARGET=linux-glibc USE_OPENSSL=1 USE_STATIC_PCRE2=1 USE_ZLIB=1 -j${CPUS}
  mkdir ${BOSH_INSTALL_TARGET}/bin
  cp haproxy ${BOSH_INSTALL_TARGET}/bin/
  chmod 755 ${BOSH_INSTALL_TARGET}/bin/haproxy
popd
